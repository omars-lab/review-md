# --- Node / build ---
node_modules/
dist/
# esbuild output (the built plugin bundle; built from src/)
main.js
*.log
.DS_Store

# --- dotenvx: NEVER commit decryption keys or plaintext local env ---
# .env.keys holds the private keys — committing it defeats encryption.
.env.keys
.env.local
.env.*.local

# NOTE: the encrypted .env (dotenvx) IS meant to be committed — it holds
# ciphertext only. Do NOT add a bare `.env` ignore or the encrypted file
# gets excluded.

# --- Obsidian machine-local state (when a dev vault lives here) ---
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# --- POC / scratch ---
poc/**/node_modules/
poc/**/main.js

# --- Dev vault: docs/ is opened as the Obsidian vault (scripts/install-dev.mjs).
# The vault CONFIG and throwaway fixtures are machine-local; the docs themselves
# and their review sidecars (docs/**/.*.comments.md) ARE tracked. ---
docs/.obsidian/
docs/sample.md
docs/plate.png
docs/POC-4-report.md
# Legacy dev vault (retired in favour of docs/; kept ignored for old checkouts).
.dev-vault/

# --- demo-media: intermediate GIF frames (final .png/.gif ARE committed) ---
docs/media/frames/
