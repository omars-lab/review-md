{
  "name": "review-md",
  "version": "0.0.1",
  "description": "Click-to-comment markdown review tool for Obsidian: anchored comment threads stored in frontmatter, shareable and repliable via obsidian:// x-callback URLs.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "secrets": "gitleaks git --pre-commit --redact --staged --verbose",
    "secrets:all": "gitleaks dir . --redact --verbose"
  },
  "keywords": ["obsidian", "obsidian-plugin", "markdown", "review", "comments", "annotations"],
  "author": "omars-lab",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0"
  }
}
