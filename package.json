{
  "name": "review-md",
  "version": "0.1.0",
  "description": "Click-to-comment markdown review tool for Obsidian: anchored comment threads stored in a git-tracked sidecar, shareable and repliable via obsidian:// x-callback URLs.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "node --test \"test/**/*.test.ts\"",
    "secrets": "gitleaks git --pre-commit --redact --staged --verbose",
    "secrets:all": "gitleaks dir . --redact --verbose",
    "install:dev": "node scripts/install-dev.mjs",
    "install:vault": "node scripts/install-plugin.mjs",
    "version:set": "node scripts/version.mjs",
    "release": "node scripts/release.mjs",
    "poc:frontmatter": "node poc/frontmatter-roundtrip.mjs",
    "api:docs": "node scripts/gen-xcallback-api.mjs",
    "api:check": "node scripts/gen-xcallback-api.mjs --check",
    "threads": "node scripts/review-threads.mjs",
    "reviews": "node scripts/reviews.mjs",
    "reanchor": "node scripts/reanchor-comments.mjs",
    "validate": "node scripts/validate-comments.mjs",
    "validate:fix": "node scripts/validate-comments.mjs --fix"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "markdown",
    "review",
    "comments",
    "annotations"
  ],
  "author": "omars-lab",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0",
    "yaml": "^2.6.0"
  }
}
